# ============================================================
# PERSISTÊNCIA DOS DADOS
# ============================================================

def salvar_dados():
    dados = {
        "proximo_id_vulnerabilidade": proximo_id_vulnerabilidade,
        "ativos": {}
    }

    for id_ativo, ativo in ativos.items():
        dados["ativos"][id_ativo] = {
            "hostname": ativo["hostname"],
            "responsavel": ativo["responsavel"],
            "tipo": ativo["tipo"].name,
            "status": ativo["status"].name,
            "vulnerabilidades": {}
        }

        for (
            id_vulnerabilidade,
            vulnerabilidade
        ) in ativo["vulnerabilidades"].items():

            dados["ativos"][id_ativo]["vulnerabilidades"][
                id_vulnerabilidade
            ] = {
                "severidade": vulnerabilidade["severidade"].name,
                "status": vulnerabilidade["status"].name
            }

    with open("dados.json", "w", encoding="utf-8") as arquivo:
        json.dump(
            dados,
            arquivo,
            indent=4,
            ensure_ascii=False
        )

    print("Dados salvos com sucesso.")


def carregar_dados():
    global ativos
    global ativos_por_hostname
    global proximo_id_vulnerabilidade

    try:
        with open("dados.json", "r", encoding="utf-8") as arquivo:
            dados = json.load(arquivo)

    except FileNotFoundError:
        ativos = {}
        ativos_por_hostname = {}
        proximo_id_vulnerabilidade = 1
        return

    except json.JSONDecodeError:
        print(
            "O arquivo de dados está inválido. "
            "Iniciando sem dados."
        )

        ativos = {}
        ativos_por_hostname = {}
        proximo_id_vulnerabilidade = 1
        return

    if (
        "proximo_id_vulnerabilidade" not in dados
        or "ativos" not in dados
    ):
        print(
            "O arquivo de dados possui uma estrutura inválida."
        )

        ativos = {}
        ativos_por_hostname = {}
        proximo_id_vulnerabilidade = 1
        return

    ativos = {}
    ativos_por_hostname = {}

    proximo_id_vulnerabilidade = (
        dados["proximo_id_vulnerabilidade"]
    )

    for id_ativo, ativo in dados["ativos"].items():
        id_ativo = int(id_ativo)

        vulnerabilidades = {}

        for (
            id_vulnerabilidade,
            vulnerabilidade
        ) in ativo["vulnerabilidades"].items():

            id_vulnerabilidade = int(id_vulnerabilidade)

            vulnerabilidades[id_vulnerabilidade] = {
                "severidade": Severidade[
                    vulnerabilidade["severidade"]
                ],
                "status": StatusTratamento[
                    vulnerabilidade["status"]
                ]
            }

        ativos[id_ativo] = {
            "hostname": ativo["hostname"],
            "responsavel": ativo["responsavel"],
            "tipo": TipoAtivo[ativo["tipo"]],
            "status": StatusAtivo[ativo["status"]],
            "vulnerabilidades": vulnerabilidades
        }

        ativos_por_hostname[ativo["hostname"]] = id_ativo


# ============================================================
# SAÍDA DO PROGRAMA
# ============================================================

def sair():
    salvar_dados()
    print("Programa encerrado.")


# ============================================================
# MENU PRINCIPAL
# ============================================================

def menu():
    while True:
        print("\nMENU PRINCIPAL")
        print("1 - Cadastro de ativos")
        print("2 - Consulta de ativos")
        print("3 - Atualização de ativos")
        print("4 - Exclusão de ativos")
        print("5 - Gerenciamento de vulnerabilidades")
        print("0 - Sair")

        try:
            escolha = int(input("Digite a opção: "))

            if escolha == 1:
                cadastrar_ativo()

            elif escolha == 2:
                consultar_ativos()

            elif escolha == 3:
                atualizar_ativo()

            elif escolha == 4:
                remover_ativo()

            elif escolha == 5:
                gerenciamento_vulnerabilidades()

            elif escolha == 0:
                sair()
                break

            else:
                print("Opção inválida. Tente novamente.")

        except ValueError:
            print("Digite um número válido.")


# ============================================================
# INICIALIZAÇÃO
# ============================================================

carregar_dados()
menu()