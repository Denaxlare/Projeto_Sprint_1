from enum import Enum
import json


# ============================================================
# ENUMERAÇÕES
# ============================================================

class TipoAtivo(Enum):
    PC = 1
    IOT = 2
    ROTEADOR = 3
    BANCO_DE_DADOS = 4


class StatusAtivo(Enum):
    ATIVO = 1
    INATIVO = 2
    EM_MANUTENCAO = 3


class Severidade(Enum):
    SEGURA = 1
    BAIXA = 2
    MEDIA = 3
    ALTA = 4
    CRITICA = 5


class StatusTratamento(Enum):
    ABERTA = 1
    EM_TRATAMENTO = 2
    CORRIGIDA = 3
    ACEITA_COMO_RISCO = 4


# ============================================================
# DADOS DO SISTEMA
# ============================================================

responsaveis = ("Camila", "Amanda", "Elaine", "Igor")

ativos = {}

ativos_por_hostname = {}

proximo_id_vulnerabilidade = 1


# ============================================================
# FUNÇÕES AUXILIARES
# ============================================================

def escolher_opcao(opcoes):
    while True:
        for indice, opcao in enumerate(opcoes, start=1):
            print(indice, "-", opcao)

        try:
            escolha = int(input("Digite um numero: "))

            if 1 <= escolha <= len(opcoes):
                return opcoes[escolha - 1]

            print("Opção inválida. Tente novamente.")

        except ValueError:
            print("Digite um número válido.")


def escolher_enum(tipo_enum):
    while True:
        for opcao in tipo_enum:
            print(opcao.value, "-", opcao.name)

        try:
            escolha = int(input("Digite um numero: "))
            return tipo_enum(escolha)

        except ValueError:
            print("Opção inválida. Tente novamente.")


def escolher_ativo_por_responsavel():
    responsavel = escolher_opcao(responsaveis)

    ativos_responsavel = {}

    for id_ativo, ativo in ativos.items():
        if ativo["responsavel"] == responsavel:
            ativos_responsavel[id_ativo] = ativo

    if not ativos_responsavel:
        print("Esse responsável não possui ativos cadastrados.")
        return None

    print("\nATIVOS DO RESPONSÁVEL")

    for id_ativo, ativo in ativos_responsavel.items():
        print(id_ativo, "-", ativo["hostname"])

    while True:
        try:
            id_ativo = int(input("Digite o ID do ativo: "))

            if id_ativo in ativos_responsavel:
                return id_ativo

            print("Esse ativo não pertence ao responsável selecionado.")

        except ValueError:
            print("Digite um número inteiro válido.")


# ============================================================
# CADASTRO DE ATIVOS
# ============================================================

def cadastrar_ativo():
    global proximo_id_vulnerabilidade

    while True:
        try:
            id_ativo = int(input("Digite o ID do ativo: "))

            if id_ativo in ativos:
                print("ID já cadastrado. Digite outro.")
                continue

            break

        except ValueError:
            print("Digite um número inteiro válido.")

    while True:
        hostname = input("Digite o Hostname/Nome: ").strip()

        if not hostname:
            print("O Hostname/Nome não pode ficar vazio.")
            continue

        if hostname in ativos_por_hostname:
            print("Esse Hostname/Nome já está cadastrado. Digite outro.")
            continue

        break

    responsavel = escolher_opcao(responsaveis)

    tipo_ativo = escolher_enum(TipoAtivo)

    status = StatusAtivo.ATIVO

    vulnerabilidades = {}

    ativos[id_ativo] = {
        "hostname": hostname,
        "responsavel": responsavel,
        "tipo": tipo_ativo,
        "status": status,
        "vulnerabilidades": vulnerabilidades
    }

    ativos_por_hostname[hostname] = id_ativo

    while True:
        print("\nDeseja cadastrar vulnerabilidades agora?")
        print("1 - Sim")
        print("2 - Não")

        try:
            escolha = int(input("Digite a opção: "))

            if escolha == 1:
                break

            if escolha == 2:
                print("Ativo cadastrado com sucesso.")
                return

            print("Opção inválida. Tente novamente.")

        except ValueError:
            print("Digite um número válido.")

    while True:
        severidade = escolher_enum(Severidade)

        status_tratamento = escolher_enum(StatusTratamento)

        ativos[id_ativo]["vulnerabilidades"][proximo_id_vulnerabilidade] = {
            "severidade": severidade,
            "status": status_tratamento
        }

        print("Vulnerabilidade cadastrada com sucesso.")

        proximo_id_vulnerabilidade += 1

        continuar = True

        while True:
            print("Deseja cadastrar outra?")
            print("1 - Sim")
            print("2 - Não")

            try:
                outra = int(input("Digite a opção: "))

                if outra == 1:
                    break

                if outra == 2:
                    continuar = False
                    break

                print("Opção inválida. Tente novamente.")

            except ValueError:
                print("Digite um número válido.")

        if not continuar:
            break

    print("Ativo cadastrado com sucesso.")


# ============================================================
# CONSULTA DE ATIVOS
# ============================================================

def consultar_por_id():
    while True:
        try:
            id_ativo = int(input("Digite o ID do ativo: "))

            if id_ativo in ativos:
                ativo = ativos[id_ativo]

                print("\nATIVO ENCONTRADO")
                print("ID:", id_ativo)
                print("Hostname:", ativo["hostname"])
                print("Responsável:", ativo["responsavel"])
                print("Tipo:", ativo["tipo"].name)
                print("Status:", ativo["status"].name)
                print(
                    "Quantidade de vulnerabilidades:",
                    len(ativo["vulnerabilidades"])
                )

                break

            print("Ativo não encontrado.")

        except ValueError:
            print("Digite um número inteiro válido.")


def consultar_por_hostname():
    hostname = input("Digite o Hostname: ").strip()

    if not hostname:
        print("O Hostname não pode ficar vazio.")
        return

    if hostname in ativos_por_hostname:
        id_ativo = ativos_por_hostname[hostname]

        ativo = ativos[id_ativo]

        print("\nATIVO ENCONTRADO")
        print("ID:", id_ativo)
        print("Hostname:", ativo["hostname"])
        print("Responsável:", ativo["responsavel"])
        print("Tipo:", ativo["tipo"].name)
        print("Status:", ativo["status"].name)
        print(
            "Quantidade de vulnerabilidades:",
            len(ativo["vulnerabilidades"])
        )

        return

    print("Ativo não encontrado.")


def consultar_ativos():
    while True:
        print("\nCONSULTA DE ATIVOS")
        print("1 - Consultar por ID")
        print("2 - Consultar por Hostname")
        print("0 - Voltar")

        try:
            escolha = int(input("Digite a opção: "))

            if escolha == 1:
                consultar_por_id()

            elif escolha == 2:
                consultar_por_hostname()

            elif escolha == 0:
                break

            else:
                print("Opção inválida. Tente novamente.")

        except ValueError:
            print("Digite um número válido.")


# ============================================================
# ATUALIZAÇÃO DE ATIVOS
# ============================================================

def atualizar_ativo():
    while True:
        try:
            id_ativo = int(input("Digite o ID do ativo: "))

            if id_ativo in ativos:
                ativo = ativos[id_ativo]
                break

            print("Ativo não encontrado.")

        except ValueError:
            print("Digite um número inteiro válido.")

    while True:
        print("\nATUALIZAÇÃO DE ATIVO")
        print("1 - Alterar responsável")
        print("2 - Alterar status do ativo")
        print("0 - Voltar")

        try:
            escolha = int(input("Digite a opção: "))

            if escolha == 1:
                novo_responsavel = escolher_opcao(responsaveis)

                if novo_responsavel == ativo["responsavel"]:
                    print(
                        "O responsável selecionado já é o "
                        "responsável atual."
                    )
                else:
                    ativo["responsavel"] = novo_responsavel
                    print("Responsável alterado com sucesso.")

            elif escolha == 2:
                novo_status = escolher_enum(StatusAtivo)

                if novo_status == ativo["status"]:
                    print(
                        "O status selecionado já é o status atual."
                    )
                else:
                    ativo["status"] = novo_status
                    print("Status alterado com sucesso.")

            elif escolha == 0:
                break

            else:
                print("Opção inválida. Tente novamente.")

        except ValueError:
            print("Digite um número válido.")


# ============================================================
# EXCLUSÃO DE ATIVOS
# ============================================================

def remover_ativo():
    while True:
        try:
            id_ativo = int(input("Digite o ID do ativo: "))

            if id_ativo in ativos:
                ativo = ativos[id_ativo]

                print("\nATIVO ENCONTRADO")
                print("Hostname:", ativo["hostname"])
                print("Responsável:", ativo["responsavel"])

                while True:
                    print("\nDeseja realmente excluir este ativo?")
                    print("1 - Sim")
                    print("2 - Não")

                    try:
                        confirmacao = int(input("Digite a opção: "))

                        if confirmacao == 1:
                            del ativos_por_hostname[ativo["hostname"]]
                            del ativos[id_ativo]

                            print("Ativo excluído com sucesso.")
                            return

                        elif confirmacao == 2:
                            print("Exclusão cancelada.")
                            return

                        else:
                            print("Opção inválida. Tente novamente.")

                    except ValueError:
                        print("Digite um número válido.")

            else:
                print("Ativo não encontrado.")

        except ValueError:
            print("Digite um número inteiro válido.")


# ============================================================
# CADASTRO DE VULNERABILIDADES
# ============================================================

def cadastrar_vulnerabilidade():
    global proximo_id_vulnerabilidade

    id_ativo = escolher_ativo_por_responsavel()

    if id_ativo is None:
        return

    while True:
        severidade = escolher_enum(Severidade)

        status_tratamento = escolher_enum(StatusTratamento)

        ativos[id_ativo]["vulnerabilidades"][
            proximo_id_vulnerabilidade
        ] = {
            "severidade": severidade,
            "status": status_tratamento
        }

        print("Vulnerabilidade cadastrada com sucesso.")
        print(
            "ID da vulnerabilidade:",
            proximo_id_vulnerabilidade
        )

        proximo_id_vulnerabilidade += 1

        while True:
            print("\nDeseja cadastrar outra vulnerabilidade?")
            print("1 - Sim")
            print("2 - Não")

            try:
                escolha = int(input("Digite a opção: "))

                if escolha == 1:
                    break

                elif escolha == 2:
                    return

                else:
                    print("Opção inválida. Tente novamente.")

            except ValueError:
                print("Digite um número válido.")


